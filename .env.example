# ===== StarVote 环境变量样例 =====
# 本地裸运行：npm start（读 PORT/DB_PATH/HOSTS）
# Docker compose：复制本文件为 .env 后 docker compose up -d

# 服务监听端口（容器内固定 5556；compose 的宿主映射端口见 HOST_PORT）
PORT="5556"

# SQLite 数据库文件路径（默认 /data/starvote.db，目录自动创建）
DB_PATH="/data/starvote.db"

# 允许访问的 Referer 域名，多个站点用英文逗号分隔：
# HOSTS="site1.com, site2.com, site3.com"
# 为空则拒绝所有请求
HOSTS="localhost, xaoxuu.com, xaox.cc"

# （compose 可选）宿主机映射到容器 5556 的端口
HOST_PORT="5556"